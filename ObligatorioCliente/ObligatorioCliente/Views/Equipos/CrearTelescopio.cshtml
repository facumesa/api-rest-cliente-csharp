@using ObligatorioCliente.DTOs
@model TelescopioDTO

@{
    ViewData["Title"] = "Alta de Telescopio";
}


<h1>CrearTelescopio</h1>

<h4>Telescopio</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="CrearTelescopio">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Apertura_mm" class="control-label"></label>
                <input asp-for="Apertura_mm" class="form-control" />
                <span asp-validation-for="Apertura_mm" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DistanciaFocal_mm" class="control-label"></label>
                <input asp-for="DistanciaFocal_mm" class="form-control" />
                <span asp-validation-for="DistanciaFocal_mm" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RelacionFocal" class="control-label"></label>
                <input asp-for="RelacionFocal" class="form-control" />
                <span asp-validation-for="RelacionFocal" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Peso" class="control-label"></label>
                <input asp-for="Peso" class="form-control" />
                <span asp-validation-for="Peso" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Marca" class="control-label"></label>
                <input asp-for="Marca" class="form-control" />
                <span asp-validation-for="Marca" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Modelo" class="control-label"></label>
                <input asp-for="Modelo" class="form-control" />
                <span asp-validation-for="Modelo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Cantidad" class="control-label"></label>
                <input asp-for="Cantidad" class="form-control" />
                <span asp-validation-for="Cantidad" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<div>
    <a asp-action="Index">Back to List</a>
</div>


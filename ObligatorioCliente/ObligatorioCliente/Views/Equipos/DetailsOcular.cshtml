@model ObligatorioCliente.DTOs.OcularDTO

@{
    ViewData["Title"] = "Detalles de Ocular";
}

<div class="page-header">

    <div>
        <h1>Detalles del Ocular</h1>

        <p class="page-subtitle">
            Información técnica y disponibilidad del ocular seleccionado.
        </p>
    </div>

    <span class="equipment-type-badge">
        ◉ Ocular
    </span>

</div>

<div class="stellar-panel">

    <div class="equipment-details-header">

        <div class="equipment-details-icon">
            ◉
        </div>

        <div>
            <span class="equipment-details-category">
                EQUIPAMIENTO ASTRONÓMICO
            </span>

            <h2>
                @Model.Marca @Model.Modelo
            </h2>
        </div>

    </div>

    <dl class="row">

        <dt class="col-sm-4">
            Diámetro
        </dt>

        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Diametro_mm) mm
        </dd>

        <dt class="col-sm-4">
            Ángulo de visión
        </dt>

        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.AnguloVision_grados)°
        </dd>

        <dt class="col-sm-4">
            Marca
        </dt>

        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Marca)
        </dd>

        <dt class="col-sm-4">
            Modelo
        </dt>

        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Modelo)
        </dd>

        <dt class="col-sm-4">
            Cantidad disponible
        </dt>

        <dd class="col-sm-8">

            @if (Model.Cantidad == 0)
            {
                <span class="badge bg-danger">
                    Sin disponibilidad
                </span>
            }
            else
            {
                <span class="badge bg-success">
                    @Model.Cantidad unidad(es)
                </span>
            }

        </dd>

    </dl>

    <div class="details-actions">

        <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">

            Editar ocular
        </a>

        <a asp-action="Index"
               class="btn btn-secondary">

            ← Volver al listado
        </a>

    </div>

</div>
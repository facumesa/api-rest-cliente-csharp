@{
    ViewData["Title"] = "Alta de Equipamiento";
}

<div class="page-header">

    <div>

        <h1>Registrar Equipamiento</h1>

        <p class="page-subtitle">
            Seleccioná el tipo de equipamiento astronómico que
            deseás incorporar al inventario de StellarMinds.
        </p>

    </div>

</div>

<div class="equipment-selector">

    <a asp-action="CrearTelescopio"
           class="equipment-option telescope">

        <div class="equipment-option-icon">
            🔭
        </div>

        <div class="equipment-option-content">

            <span class="equipment-option-category">
                OBSERVACIÓN
            </span>

            <h3>
                Telescopio
            </h3>

            <p>
                Registrá tubos ópticos indicando apertura,
                distancia focal, relación focal y peso.
            </p>

        </div>

        <span class="equipment-option-arrow">
            →
        </span>

    </a>

    <a asp-action="CrearMontura"
           class="equipment-option mount">

        <div class="equipment-option-icon">
            ⚙
        </div>

        <div class="equipment-option-content">

            <span class="equipment-option-category">
                SOPORTE
            </span>

            <h3>
                Montura
            </h3>

            <p>
                Configurá el tipo de montura,
                carga útil y sistema GoTo.
            </p>

        </div>

        <span class="equipment-option-arrow">
            →
        </span>

    </a>

    <a asp-action="CrearCamara"
           class="equipment-option camera">

        <div class="equipment-option-icon">
            📷
        </div>

        <div class="equipment-option-content">

            <span class="equipment-option-category">
                ASTROFOTOGRAFÍA
            </span>

            <h3>
                Cámara
            </h3>

            <p>
                Registrá cámaras CCD o CMOS,
                resolución y tamaño del píxel.
            </p>

        </div>

        <span class="equipment-option-arrow">
            →
        </span>

    </a>

    <a asp-action="CrearOcular"
           class="equipment-option ocular">

        <div class="equipment-option-icon">
            👁
        </div>

        <div class="equipment-option-content">

            <span class="equipment-option-category">
                OBSERVACIÓN VISUAL
            </span>

            <h3>
                Ocular
            </h3>

            <p>
                Registrá diámetro
                y ángulo aparente de visión.
            </p>

        </div>

        <span class="equipment-option-arrow">
            →
        </span>

    </a>

</div>
@using ObligatorioCliente.DTOs
@model OcularDTO

@{
    ViewData["Title"] = "Alta de Ocular";
}

<h1>CrearOcular</h1>

<h4>Ocular</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="CrearOcular">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Diametro_mm" class="control-label"></label>
                <input asp-for="Diametro_mm" class="form-control" />
                <span asp-validation-for="Diametro_mm" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AnguloVision_grados" class="control-label"></label>
                <input asp-for="AnguloVision_grados" class="form-control" />
                <span asp-validation-for="AnguloVision_grados" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Marca" class="control-label"></label>
                <input asp-for="Marca" class="form-control" />
                <span asp-validation-for="Marca" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Modelo" class="control-label"></label>
                <input asp-for="Modelo" class="form-control" />
                <span asp-validation-for="Modelo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Cantidad" class="control-label"></label>
                <input asp-for="Cantidad" class="form-control" />
                <span asp-validation-for="Cantidad" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<div>
    <a asp-action="Index">Back to List</a>
</div>


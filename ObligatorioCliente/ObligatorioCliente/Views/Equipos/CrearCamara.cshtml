@using ObligatorioCliente.DTOs
@model CamaraDTO

@{
    ViewData["Title"] = "Alta de Cámara";
}

<div class="page-header">

    <div>
        <h1>Registrar Cámara</h1>

        <p class="page-subtitle">
            Ingresá la información general y las características
            técnicas de la nueva cámara astronómica.
        </p>
    </div>

    <span class="equipment-type-badge">
        📷 Cámara
    </span>

</div>

<div class="equipment-form-container">

    <div class="equipment-form-header">

        <div class="equipment-details-icon">
            📷
        </div>

        <div>
            <span class="equipment-details-category">
                NUEVO EQUIPAMIENTO
            </span>

            <h2>Alta de cámara</h2>

            <p>
                Registrá una cámara para utilizarla
                en sesiones de astrofotografía.
            </p>
        </div>

    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger" role="alert">

            <strong>No se pudo registrar la cámara.</strong>

            <div>
                @ViewBag.Error
            </div>

        </div>
    }

    <form asp-action="CrearCamara" method="post">

        <div asp-validation-summary="ModelOnly"
             class="validation-summary-errors mb-4">
        </div>

        <div class="form-section">

            <div class="form-section-heading">

                <span class="form-section-icon">
                    ◇
                </span>

                <div>
                    <h3>Información general</h3>

                    <p>
                        Datos identificativos y cantidad inicial.
                    </p>
                </div>

            </div>

            <div class="row g-4">

                <div class="col-md-4">

                    <label asp-for="Marca"
                           class="form-label">

                        Marca
                    </label>

                    <input asp-for="Marca"
                           class="form-control"
                           placeholder="Ejemplo: ZWO" />

                    <span asp-validation-for="Marca"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-4">

                    <label asp-for="Modelo"
                           class="form-label">

                        Modelo
                    </label>

                    <input asp-for="Modelo"
                           class="form-control"
                           placeholder="Ejemplo: ASI 294MC Pro" />

                    <span asp-validation-for="Modelo"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-4">

                    <label asp-for="Cantidad"
                           class="form-label">

                        Cantidad disponible
                    </label>

                    <input asp-for="Cantidad"
                           class="form-control"
                           min="0"
                           placeholder="Ejemplo: 4" />

                    <span asp-validation-for="Cantidad"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

        <div class="form-section">

            <div class="form-section-heading">

                <span class="form-section-icon">
                    ✦
                </span>

                <div>
                    <h3>Características técnicas</h3>

                    <p>
                        Especificaciones utilizadas para evaluar
                        sesiones de astrofotografía.
                    </p>
                </div>

            </div>

            <div class="row g-4">

                <div class="col-md-4">

                    <label asp-for="TipoSensor"
                           class="form-label">

                        Tipo de sensor
                    </label>

                    <select asp-for="TipoSensor"
                            class="form-select"
                            asp-items="Html.GetEnumSelectList<ObligatorioCliente.Enums.TipoSensor>()">

                        <option value="">
                            -- Seleccione un sensor --
                        </option>

                    </select>

                    <span asp-validation-for="TipoSensor"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-4">

                    <label asp-for="Resolucion"
                           class="form-label">

                        Resolución
                    </label>

                    <input asp-for="Resolucion"
                           class="form-control"
                           placeholder="Ejemplo: 4144x2822" />

                    <span asp-validation-for="Resolucion"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-4">

                    <label asp-for="TamanioPixel"
                           class="form-label">

                        Tamaño del píxel
                    </label>

                    <div class="input-group">

                        <input asp-for="TamanioPixel"
                               class="form-control"
                               placeholder="Ejemplo: 4,63" />

                        <span class="input-group-text">
                            µm
                        </span>

                    </div>

                    <span asp-validation-for="TamanioPixel"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

        <div class="form-actions">

            <a asp-action="Create"
                   class="btn btn-secondary">

                ← Volver
            </a>

            <button type="submit"
                    class="btn btn-primary">

                Registrar cámara
            </button>

        </div>

    </form>

</div>
@using ObligatorioCliente.DTOs
@model CamaraDTO

@{
    ViewData["Title"] = "Alta de Camara";
}

<h1>CrearCamara</h1>

<h4>Camara</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="CrearCamara">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="TipoSensor" class="control-label"></label>
                <select asp-for="TipoSensor" class="form-control" asp-items="Html.GetEnumSelectList<ObligatorioCliente.Enums.TipoSensor>()">
                    <option value="">-- Seleccione un Sensor --</option>
                </select>
                <span asp-validation-for="TipoSensor" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Resolucion" class="control-label"></label>
                <input asp-for="Resolucion" class="form-control" />
                <span asp-validation-for="Resolucion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TamanioPixel" class="control-label"></label>
                <input asp-for="TamanioPixel" class="form-control" />
                <span asp-validation-for="TamanioPixel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Marca" class="control-label"></label>
                <input asp-for="Marca" class="form-control" />
                <span asp-validation-for="Marca" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Modelo" class="control-label"></label>
                <input asp-for="Modelo" class="form-control" />
                <span asp-validation-for="Modelo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Cantidad" class="control-label"></label>
                <input asp-for="Cantidad" class="form-control" />
                <span asp-validation-for="Cantidad" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@model ObligatorioCliente.DTOs.UsuarioDTO

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="login-page">
    <div class="login-card">

        <div class="login-visual">

            <div class="login-visual-content">

                <span class="login-eyebrow">
                    ✦ STELLARMINDS
                </span>

                <h1>
                    Bienvenido al observatorio
                </h1>

                <p>
                    Accedé al sistema para gestionar préstamos,
                    equipamiento y observaciones astronómicas.
                </p>

                <div class="login-orbit">

                    <div class="login-orbit-ring login-orbit-ring-one"></div>
                    <div class="login-orbit-ring login-orbit-ring-two"></div>

                    <div class="login-planet">
                        <span></span>
                    </div>

                    <span class="login-star login-star-one">✦</span>
                    <span class="login-star login-star-two">✧</span>
                    <span class="login-star login-star-three">✦</span>

                </div>

            </div>

        </div>

        <div class="login-form-side">

            <div class="login-form-header">

                <div class="login-logo">
                    ✦
                </div>

                <div>
                    <span class="login-form-label">
                        ACCESO AL SISTEMA
                    </span>

                    <h2>
                        Iniciar sesión
                    </h2>

                    <p>
                        Ingresá tus credenciales para continuar.
                    </p>
                </div>

            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">

                    <strong>No se pudo iniciar sesión.</strong>

                    <div>
                        @ViewBag.Error
                    </div>

                </div>
            }

            <form asp-action="Login" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary-errors mb-3">
                </div>

                <div class="login-field">

                    <label asp-for="NombreUsuario"
                           class="form-label">

                        Nombre de usuario
                    </label>

                    <div class="login-input-wrapper">

                        <span class="login-input-icon">
                            ◇
                        </span>

                        <input asp-for="NombreUsuario"
                               class="form-control"
                               placeholder="Ingresá tu usuario"
                               autocomplete="username" />

                    </div>

                    <span asp-validation-for="NombreUsuario"
                          class="text-danger">
                    </span>

                </div>

                <div class="login-field">

                    <label asp-for="Contrasenia"
                           class="form-label">

                        Contraseña
                    </label>

                    <div class="login-input-wrapper">

                        <span class="login-input-icon">
                            ●
                        </span>

                        <input asp-for="Contrasenia"
                               type="password"
                               class="form-control"
                               placeholder="Ingresá tu contraseña"
                               autocomplete="current-password" />

                    </div>

                    <span asp-validation-for="Contrasenia"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit"
                        class="btn btn-primary login-submit">

                    Ingresar a StellarMinds
                    <span>→</span>

                </button>

            </form>

            <div class="login-footer">

                <span>✦</span>

                <p>
                    El acceso está disponible únicamente
                    para usuarios registrados.
                </p>

            </div>

        </div>

    </div>

</div>

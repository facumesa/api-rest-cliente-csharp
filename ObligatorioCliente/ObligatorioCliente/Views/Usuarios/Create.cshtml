@{
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="page-header">

    <div>
        <h1>Registrar Nuevo Usuario</h1>

        <p class="page-subtitle">
            Seleccioná el perfil del usuario que deseás incorporar
            al sistema de StellarMinds.
        </p>
    </div>

</div>

<div class="user-selector">

    <a asp-controller="Usuarios"
           asp-action="CrearSocio"
           class="user-option user-option-member">

        <div class="user-option-icon">
            S
        </div>

        <div class="user-option-content">

            <span class="user-option-category">
                MIEMBRO DEL CLUB
            </span>

            <h3>Socio</h3>

            <p>
                Puede solicitar préstamos de equipamiento,
                consultar sus préstamos y registrar observaciones astronómicas.
            </p>

            <div class="user-option-features">

                <span>Préstamos</span>
                <span>Observaciones</span>
                <span>Ranking</span>

            </div>

        </div>

        <span class="user-option-arrow">
            →
        </span>

    </a>

    <a asp-controller="Usuarios"
           asp-action="CrearCoordinador"
           class="user-option user-option-coordinator">

        <div class="user-option-icon">
            C
        </div>

        <div class="user-option-content">

            <span class="user-option-category">
                GESTIÓN OPERATIVA
            </span>

            <h3>Coordinador</h3>

            <p>
                Se encarga de registrar préstamos,
                procesar devoluciones y consultar socios por telescopio.
            </p>

            <div class="user-option-features">

                <span>Altas de préstamo</span>
                <span>Devoluciones</span>
                <span>Consultas</span>

            </div>

        </div>

        <span class="user-option-arrow">
            →
        </span>

    </a>

    <a asp-controller="Usuarios"
           asp-action="CrearAdministrador"
           class="user-option user-option-admin">

        <div class="user-option-icon">
            A
        </div>

        <div class="user-option-content">

            <span class="user-option-category">
                ADMINISTRACIÓN GENERAL
            </span>

            <h3>Administrador</h3>

            <p>
                Tiene acceso a la administración de usuarios,
                equipamiento, auditorías y funcionalidades generales.
            </p>

            <div class="user-option-features">

                <span>Usuarios</span>
                <span>Equipos</span>
                <span>Auditoría</span>

            </div>

        </div>

        <span class="user-option-arrow">
            →
        </span>

    </a>

</div>

<div class="user-selector-footer">

    <div class="user-selector-information">

        <span class="user-selector-information-icon">
            ✦
        </span>

        <p>
            Cada usuario visualizará únicamente las funcionalidades
            habilitadas para el rol asignado.
        </p>

    </div>

    <a asp-action="Index"
           class="btn btn-secondary">

        ← Volver al listado
    </a>

</div>
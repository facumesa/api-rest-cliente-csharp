@model IEnumerable<ObligatorioCliente.DTOs.PrestamoDTO>

<h1>Prestamos</h1>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">

        <p>El coordinador seleccionado no posee prestamos vinculados.</p>

    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Id)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FechaPrestamo)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Estado)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Id)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FechaPrestamo)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Estado)
                    </td>
                    <td>
                        <a asp-action="Auditoria"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-info">
                            Ver Auditoria
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="text-center mt-4">
    <a asp-action="SeleccionarCoordinador" asp-controller="Prestamos" class="btn btn-link text-secondary">Volver a seleccionar coordinador</a>
</div>

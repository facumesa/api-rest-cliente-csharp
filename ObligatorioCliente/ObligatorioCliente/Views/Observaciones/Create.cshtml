@model ObligatorioCliente.Models.ViewModels.ObservacionesViewModel

@{
    ViewData["Title"] = "Registrar observación";

    string? indicador = ViewBag.IndicadorIA?.ToString();
    string claseIndicador = indicador switch
    {
        "IDEAL" => "ai-result-ideal",
        "ADECUADO" => "ai-result-suitable",
        "NO RECOMENDABLE" => "ai-result-not-recommended",
        _ => "ai-result-neutral"
    };
}

<div class="page-header">

    <div>
        <h1>Registrar Observación Astronómica</h1>

        <p class="page-subtitle">
            Seleccioná un préstamo vigente y el objeto celeste que
            deseás observar. Gemini evaluará si el equipamiento es adecuado.
        </p>
    </div>

    <span class="equipment-type-badge">
        ✦ Nueva observación
    </span>

</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mb-4">

        <strong>No se pudo completar la operación.</strong>

        <div>
            @ViewBag.Error
        </div>

    </div>
}

@if (ViewBag.Exito != null)
{
    <div class="alert alert-success mb-4">

        <strong>Observación registrada correctamente.</strong>

        <div>
            @ViewBag.Exito
        </div>

    </div>
}

<div class="observation-layout">

    <div class="observation-form-panel">

        <div class="equipment-form-header">

            <div class="equipment-details-icon">
                🔭
            </div>

            <div>
                <span class="equipment-details-category">
                    PLANIFICACIÓN ASTRONÓMICA
                </span>

                <h2>Datos de la observación</h2>

                <p>
                    Completá los datos y evaluá la compatibilidad
                    antes de guardar.
                </p>
            </div>

        </div>

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary-errors mb-4">
            </div>

            <div class="form-section">

                <div class="form-section-heading">

                    <span class="form-section-icon">
                        1
                    </span>

                    <div>
                        <h3>Fecha de observación</h3>

                        <p>
                            Indicá cuándo se realizará la sesión astronómica.
                        </p>
                    </div>

                </div>

                <div class="row">

                    <div class="col-lg-6">

                        <label asp-for="Observacion.FechaObservacion"
                               class="form-label">

                            Fecha
                        </label>

                        <input asp-for="Observacion.FechaObservacion"
                               class="form-control" />

                        <span asp-validation-for="Observacion.FechaObservacion"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

            <div class="form-section">

                <div class="form-section-heading">

                    <span class="form-section-icon">
                        2
                    </span>

                    <div>
                        <h3>Préstamo asociado</h3>

                        <p>
                            Seleccioná el conjunto de equipos que utilizarás.
                        </p>
                    </div>

                </div>

                <label asp-for="Observacion.PrestamoId"
                       class="form-label">

                    Préstamo vigente
                </label>

                <select asp-for="Observacion.PrestamoId"
                        class="form-select observation-select">

                    <option value="">
                        -- Seleccioná un préstamo --
                    </option>

                    @foreach (var prestamo in Model.Prestamos)
                    {
                        <option value="@prestamo.Id">
                            Préstamo #@prestamo.Id |
                            @prestamo.Estado |
                            Telescopio: @prestamo.DescripcionTelescopio |
                            Montura: @prestamo.DescripcionMontura |
                            Cámara: @prestamo.DescripcionCamara |
                            Ocular: @prestamo.DescripcionOcular
                        </option>
                    }

                </select>

                <span asp-validation-for="Observacion.PrestamoId"
                      class="text-danger">
                </span>

                @if (Model.Prestamos == null || !Model.Prestamos.Any())
                {
                    <div class="observation-help-warning">

                        <span>⚠</span>

                        <p>
                            No tenés préstamos vigentes disponibles
                            para asociar a una observación.
                        </p>

                    </div>
                }

            </div>

            <div class="form-section">

                <div class="form-section-heading">

                    <span class="form-section-icon">
                        3
                    </span>

                    <div>
                        <h3>Objeto celeste</h3>

                        <p>
                            Elegí el astro que deseás observar o fotografiar.
                        </p>
                    </div>

                </div>

                <label asp-for="Observacion.ObjetoCelesteId"
                       class="form-label">

                    Objeto celeste
                </label>

                <select asp-for="Observacion.ObjetoCelesteId"
                        class="form-select">

                    <option value="">
                        -- Seleccioná un objeto celeste --
                    </option>

                    @foreach (var objeto in Model.ObjetosCelestes)
                    {
                        <option value="@objeto.Id">
                            @objeto.Nombre
                        </option>
                    }

                </select>

                <span asp-validation-for="Observacion.ObjetoCelesteId"
                      class="text-danger">
                </span>

            </div>

            <div class="observation-evaluate-section">

                <div class="observation-evaluate-information">

                    <span class="observation-ai-icon">
                        ✦
                    </span>

                    <div>
                        <strong>Evaluación mediante Gemini</strong>

                        <p>
                            La IA analizará el telescopio, la montura,
                            la cámara u ocular y el objeto seleccionado.
                        </p>
                    </div>

                </div>

                <button type="submit"
                        name="accion"
                        value="evaluar"
                        class="btn btn-primary observation-evaluate-button"
                    @(Model.Prestamos == null || !Model.Prestamos.Any()
                                                ? "disabled"
                                                : null)>

                    Evaluar adecuación
                    <span>→</span>
                </button>

            </div>

            @if (ViewBag.IndicadorIA != null)
            {
                <input type="hidden"
                       asp-for="Observacion.ResultadoAdecuacion"
                       value="@ViewBag.IndicadorIA" />

                <input type="hidden"
                       asp-for="Observacion.MotivoAdecuacion"
                       value="@ViewBag.MotivoIA" />

                <div class="ai-result @claseIndicador">

                    <div class="ai-result-header">

                        <div class="ai-result-icon">
                            ✦
                        </div>

                        <div>
                            <span class="ai-result-label">
                                RESULTADO DE GEMINI
                            </span>

                            <h3>
                                Evaluación completada
                            </h3>
                        </div>

                        <span class="ai-result-indicator">
                            @ViewBag.IndicadorIA
                        </span>

                    </div>

                    <div class="ai-result-body">

                        <span class="ai-result-detail-label">
                            ANÁLISIS DEL EQUIPAMIENTO
                        </span>

                        <p>
                            @ViewBag.MotivoIA
                        </p>

                    </div>

                    <div class="ai-result-actions">

                        <p>
                            Podés modificar el préstamo o el objeto
                            y volver a evaluar antes de confirmar.
                        </p>

                        <button type="submit"
                                name="accion"
                                value="guardar"
                                class="btn btn-success">

                            Confirmar y guardar observación
                        </button>

                    </div>

                </div>
            }

        </form>

    </div>

    <aside class="observation-guide">

        <div class="observation-guide-card">

            <span class="observation-guide-icon">
                ☾
            </span>

            <h3>¿Cómo funciona?</h3>

            <ol class="observation-steps">

                <li>
                    <span>1</span>

                    <div>
                        <strong>Seleccioná la fecha</strong>

                        <p>
                            Debe encontrarse dentro de la vigencia
                            del préstamo.
                        </p>
                    </div>
                </li>

                <li>
                    <span>2</span>

                    <div>
                        <strong>Elegí el equipamiento</strong>

                        <p>
                            Solo se muestran los préstamos vigentes
                            y no devueltos.
                        </p>
                    </div>
                </li>

                <li>
                    <span>3</span>

                    <div>
                        <strong>Seleccioná un objeto</strong>

                        <p>
                            Puede ser un planeta, estrella,
                            galaxia o nebulosa.
                        </p>
                    </div>
                </li>

                <li>
                    <span>4</span>

                    <div>
                        <strong>Evaluá con Gemini</strong>

                        <p>
                            El resultado puede ser ideal,
                            adecuado o no recomendable.
                        </p>
                    </div>
                </li>

            </ol>

        </div>

        <div class="observation-guide-card observation-guide-secondary">

            <span class="observation-guide-icon">
                ✦
            </span>

            <h3>Tipo de observación</h3>

            <p>
                Si el préstamo incluye una cámara,
                el sistema considerará que se trata
                de una sesión de astrofotografía.
            </p>

            <p>
                Si incluye un ocular, se evaluará
                como observación visual directa.
            </p>

        </div>

        <a asp-action="Index"
               asp-controller="Home"
               class="btn btn-secondary w-100">

            ← Volver al inicio
        </a>

    </aside>

</div>
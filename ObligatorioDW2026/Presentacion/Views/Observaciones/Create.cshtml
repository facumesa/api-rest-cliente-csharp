@model Presentacion.Models.ViewModels.ObservacionesViewModel

@{
    ViewData["Title"] = "Crear observacion";
}

<h1>Registrar Observación Astronómica</h1>
<h4>Observacion</h4>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Observacion.FechaObservacion" class="control-label"></label>
                <input asp-for="Observacion.FechaObservacion" class="form-control" />
                <span asp-validation-for="Observacion.FechaObservacion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Observacion.PrestamoId" class="control-label">Préstamo Asociado</label>
                <select asp-for="Observacion.PrestamoId" class="form-control">
                    <option value="">-- Seleccionar Prestamo --</option>
                    @foreach (var s in Model.Prestamos)
                    {
                        <option value="@s.Id">@s.Id | @s.Estado | Camara: @s.DescripcionCamara | Montura: @s.DescripcionMontura | Ocular: @s.DescripcionOcular | Telescopio: @s.DescripcionTelescopio</option>
                    }
                </select>
                <span asp-validation-for="Observacion.PrestamoId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Observacion.ObjetoCelesteId" class="control-label">Objeto Celeste (Astro)</label>
                <select asp-for="Observacion.ObjetoCelesteId" class="form-control">
                    <option value="">-- Seleccionar ObjetoCeleste --</option>
                    @foreach (var s in Model.ObjetosCelestes)
                    {
                        <option value="@s.Id">@s.Id | @s.Nombre</option>
                    }
                </select>
                <span asp-validation-for="Observacion.ObjetoCelesteId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <button type="submit" name="accion" value="evaluar" class="btn btn-secondary">
                    Evaluar Adecuación con IA
                </button>
            </div>

            <hr />

            @if (ViewBag.IndicadorIA != null)
            {
                <div class="alert alert-info my-3">
                    <h4><i class="bi bi-robot"></i> Resultado del Análisis de la IA:</h4>
                    <p><strong>Indicador de Adecuación:</strong> <span class="badge bg-dark">@ViewBag.IndicadorIA</span></p>
                    <p><strong>Motivo / Sugerencia:</strong> @ViewBag.MotivoIA</p>
                </div>

                <input type="hidden" asp-for="Observacion.ResultadoAdecuacion" value="@ViewBag.IndicadorIA" />
                <input type="hidden" asp-for="Observacion.MotivoAdecuacion" value="@ViewBag.MotivoIA" />

                <div class="form-group mb-3">
                    <button type="submit" name="accion" value="guardar" class="btn btn-success">
                        Confirmar y Guardar Observación
                    </button>
                </div>
            }
        </form>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mt-3">
        <strong>Error:</strong> @ViewBag.Error
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-link">Volver al Listado</a>
</div>


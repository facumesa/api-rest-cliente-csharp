@{
    ViewData["Title"] = "Alta de Equipos";
}

<h1>Crear</h1>

<div class="container mt-5">
    <h2 class="text-center mb-4">¿Qué tipo de equipo desea registrar?</h2>
    <div class="row justify-content-center">
        <div class="col-md-3">
            <div class="card text-center h-100 shadow-sm">
                <div class="card-body">
                    <i class="bi bi-camera-fill style="font-size: 2rem;"></i>
                    <h5 class="card-title mt-3">Cámara</h5>
                    <p class="card-text text-muted">Sensores CMOS, CCD, resolución y tamaño de pixel.</p>
                    <a asp-action="CrearCamara" class="btn btn-primary btn-block">Seleccionar</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center h-100 shadow-sm">
                <div class="card-body">
                    <i class="bi bi-telescope" style="font-size: 2rem;"></i>
                    <h5 class="card-title mt-3">Telescopio</h5>
                    <p class="card-text text-muted">Apertura, distancia focal, relación focal y peso.</p>
                    <a asp-action="CrearTelescopio" class="btn btn-primary btn-block">Seleccionar</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center h-100 shadow-sm">
                <div class="card-body">
                    <i class="bi bi-telescope" style="font-size: 2rem;"></i>
                    <h5 class="card-title mt-3">Monturas</h5>
                    <p class="card-text text-muted">Tipo de montura, carga útil y si es computarizado o no.</p>
                    <a asp-action="CrearMontura" class="btn btn-primary btn-block">Seleccionar</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center h-100 shadow-sm">
                <div class="card-body">
                    <i class="bi bi-telescope" style="font-size: 2rem;"></i>
                    <h5 class="card-title mt-3">Oculares</h5>
                    <p class="card-text text-muted">Diámetro y ángulo de visión.</p>
                    <a asp-action="CrearOcular" class="btn btn-primary btn-block">Seleccionar</a>
                </div>
            </div>
        </div>
        
    </div>
</div>

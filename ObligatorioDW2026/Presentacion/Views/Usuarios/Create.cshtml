@{
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h2 class="display-4">Registrar Nuevo Usuario</h2>
        <p class="lead text-muted">Seleccione el perfil del usuario que desea dar de alta en el sistema.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-primary">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-person-badge" style="font-size: 3rem; color: #0d6efd;"></i>
                    </div>
                    <h5 class="card-title">Socio</h5>
                    <p class="card-text">Persona que solicita préstamos de equipos astronómicos y observaciones.</p>
                    <a asp-controller="Usuarios" asp-action="CrearSocio" class="btn btn-primary w-100">
                        Crear Socio
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-secondary">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-person-gear" style="font-size: 3rem; color: #eb6f28;"></i>
                    </div>
                    <h5 class="card-title">Coordinador</h5>
                    <p class="card-text">Personal encargado de gestionar los préstamos y equipos.</p>
                    <a asp-controller="Usuarios" asp-action="CrearCoordinador" class="btn btn-secondary w-100">
                        Crear Coordinador
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-success">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-person-badge" style="font-size: 3rem; color: #198754;"></i>
                    </div>
                    <h5 class="card-title">Administrador</h5>
                    <p class="card-text">Persona que administra todas las funcionalidades de la app.</p>
                    <a asp-controller="Usuarios" asp-action="CrearAdministrador" class="btn btn-success w-100">
                        Crear Administrador
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-4">
        <a asp-action="Index" class="btn btn-link text-secondary">Volver al listado</a>
    </div>
</div>